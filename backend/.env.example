# Serveur
PORT=5000
NODE_ENV=development

# Base de données (MongoDB Atlas recommandé pour Render)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/dan-online?retryWrites=true&w=majority

# Authentification
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=30d

# Commission plateforme par défaut (en %)
DEFAULT_COMMISSION_RATE=10

# CORS - domaine(s) autorisé(s) du frontend
CLIENT_URL=http://localhost:3000

# Authentification Google
GOOGLE_CLIENT_ID=votre_client_id.apps.googleusercontent.com

# Paiement FedaPay
FEDAPAY_SECRET_KEY=votre_cle_secrete
FEDAPAY_PUBLIC_KEY=votre_cle_publique
FEDAPAY_ENV=sandbox
